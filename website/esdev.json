{
  "plugins": [
    {
      "module": "@opentf/esdev-plugin-afw",
      "options": {
        "mode": "ssg",
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "docsNavPlugin",
      "options": {
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "blogPostsPlugin",
      "options": {
        "appDir": "website/app",
        "contentDir": "blog"
      }
    },
    {
      "module": "@opentf/afw-docs/build",
      "export": "lastUpdatedPlugin",
      "options": {
        "appDir": "website/app"
      }
    },
    {
      "module": "@opentf/afw-cli/ssg",
      "export": "siteOutputPlugin",
      "options": {
        "root": "website",
        "target": "web",
        "prerenderTarget": "site-ssg"
      }
    }
  ],
  "build": {
    "targets": {
      "web": {
        "entry": "index.html",
        "outdir": "dist",
        "assets": [
          "public"
        ]
      },
      "site-ssg": {
        "entry": "ssg.js",
        "out": ".ssg/ssg.js",
        "then": "run"
      }
    }
  },
  "dev": {
    "server": {
      "port": 3005
    }
  }
}
