{
  "name": "@opentf/afw-test",
  "version": "1.27.0",
  "description": "DOM testing utilities for AFW",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "peerDependencies": {
    "@opentf/afw": "workspace:*"
  },
