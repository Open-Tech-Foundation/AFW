{
  "name": "@opentf/vite-plugin-afw",
  "version": "0.6.0",
  "description": "Compile AFW components and serve file-based routes in Vite.",
  "type": "module",
  "scripts": {
    "build": "cp ../../LICENSE LICENSE"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "host.js",
    "server.js",
    "server.d.ts",
    "client.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentf/afw-build": "workspace:*",
    "@opentf/afw-compiler": "workspace:*"
  },
  "peerDependencies": {
    "@opentf/afw": "workspace:*",
    "vite": ">=7"
  },
  "devDependencies": {
    "@opentf/afw": "workspace:*",
    "@opentf/afw-test": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "afw",
    "opentf",
    "vite",
    "vite-plugin",
    "jsx",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/afw.git",
    "directory": "packages/vite-plugin-afw"
  },
  "homepage": "https://afw.opentechf.org/docs",
  "bugs": "https://github.com/Open-Tech-Foundation/afw/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
