{
  "name": "@opentf/afw",
  "version": "0.32.0",
  "description": "The AFW runtime: signals and zero-VDOM DOM bindings, with routing and server rendering.",
  "type": "module",
  "scripts": {
    "build": "cp ../../LICENSE LICENSE"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./signals": {
      "types": "./core/signals.d.ts",
      "default": "./core/signals.js"
    },
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./server": {
      "types": "./server/index.d.ts",
      "default": "./server/index.js"
    },
    "./server/adapters/node": {
      "types": "./server/adapters/node.d.ts",
      "default": "./server/adapters/node.js"
    },
    "./hmr": "./runtime/hmr.js",
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "jsx-runtime.d.ts",
    "core",
    "runtime",
    "components",
    "server",
    "!**/*.test.js"
  ],
  "keywords": [
    "afw",
    "opentf",
    "signals",
    "reactivity",
    "web-components",
    "custom-elements",
    "jsx",
    "ssr",
    "ssg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/afw.git",
    "directory": "packages/afw"
  },
  "homepage": "https://afw.opentechf.org",
  "bugs": "https://github.com/Open-Tech-Foundation/afw/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "types": "./index.d.ts"
}
