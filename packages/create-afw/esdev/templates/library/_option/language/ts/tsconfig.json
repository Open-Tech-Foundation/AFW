{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentf/afw",
    "types": [
      "@opentf/esrun-types"
    ],
    "customConditions": [
      "esdev"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "index.ts",
    "src",
    "app",
    "tests",
    "entry.ts"
  ]
}
