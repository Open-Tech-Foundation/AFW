{
  "name": "@opentf/create-afw",
  "version": "0.5.0",
  "description": "Create an AFW app on Vite and Node: npm create @opentf/afw.",
  "type": "module",
  "bin": {
    "create-afw": "./index.js"
  },
  "scripts": {
    "build": "cp ../../LICENSE LICENSE && node scripts/write-versions.mjs"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "templates.js",
    "versions.js",
    "versions.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@opentf/afw": "workspace:*",
    "@opentf/afw-docs": "workspace:*",
    "@opentf/afw-form": "workspace:*",
    "@opentf/afw-test": "workspace:*",
    "@opentf/vite-plugin-afw": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "afw",
    "opentf",
    "create",
    "scaffold",
    "vite",
    "starter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Tech-Foundation/afw.git",
    "directory": "packages/create-afw"
  },
  "homepage": "https://afw.opentechf.org/docs",
  "bugs": "https://github.com/Open-Tech-Foundation/afw/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@opentf/std": "0.20.0"
  }
}
