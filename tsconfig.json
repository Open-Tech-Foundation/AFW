{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "allowJs": true,
    "types": ["@opentf/esrun-types"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@opentf/afw": ["./packages/afw/index.js"],
      "@opentf/afw/hmr": ["./packages/afw/runtime/hmr.js"],
      "@opentf/afw/compiler": ["./packages/afw/compiler/index.js"],
      "@opentf/afw-form": ["./packages/afw-form/index.js"],
      "@opentf/afw-test": ["./packages/afw-test/index.js"],
      "@opentf/afw-test/*": ["./packages/afw-test/*"]
    }
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.dev",
    "target",
    "benchmarks/**/dist"
  ]
}
